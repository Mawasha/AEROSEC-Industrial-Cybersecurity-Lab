        <mxCell id="blk1" value="✖ BLOQUÉ&#xa;VLAN 20 → VLAN 61&#xa;Aucun poste bureautique&#xa;n'atteint l'automate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;fontColor=#8B0000;dashed=1;" vertex="1" parent="1">
