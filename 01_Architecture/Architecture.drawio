        <mxCell id="blk2" value="✖ BLOQUÉ&#xa;OT → INTERNET&#xa;Mises à jour via SRV-PATCH-OT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;fontColor=#8B0000;dashed=1;" vertex="1" parent="1">
