        <mxCell id="lg_d" value="✖  Flux explicitement refusé et journalisé" style="text;html=1;align=left;fontSize=10;fontColor=#8B0000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="385" y="1240" width="290" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg_e" value="Politique pare-feu : DENY BY DEFAULT. Chaque règle d'autorisation&#xa;est adossée à une ligne de la matrice de flux (dossier 02_Network).&#xa;Toutes les règles sont configurées avec journalisation active." style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="1295" width="600" height="50" as="geometry" />
        </mxCell>

