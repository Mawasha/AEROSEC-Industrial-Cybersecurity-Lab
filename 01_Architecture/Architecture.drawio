        </mxCell>
        <mxCell id="blk4" value="✖ BLOQUÉ&#xa;VLAN 20 → VLAN 40&#xa;La supervision n'est pas&#xa;accessible aux utilisateurs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;fontColor=#8B0000;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="670" width="270" height="75" as="geometry" />
        </mxCell>
        <mxCell id="siem" value="COLLECTE SIEM&#xa;Toutes les zones remontent vers VLAN 40.&#xa;Flux toujours initiés par l'agent vers le SIEM,&#xa;jamais l'inverse — la compromission du SOC&#xa;n'ouvre pas d'accès aux machines supervisées." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1330" y="770" width="270" height="110" as="geometry" />
        </mxCell>

