        <mxCell id="blk3" value="✖ BLOQUÉ&#xa;INTERNET → IT / OT / SOC&#xa;Seule la DMZ est exposée" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;fontColor=#8B0000;dashed=1;" vertex="1" parent="1">
